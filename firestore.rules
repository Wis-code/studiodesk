rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function userPath(){ return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile(){ return signedIn() && exists(userPath()); }
    function profile(){ return get(userPath()).data; }
    function active(){ return hasProfile() && profile().status == 'active'; }
    function role(r){ return active() && profile().role == r; }
    function owner(){ return role('owner'); }
    function admin(){ return role('admin'); }
    function ownerAdmin(){ return owner() || admin(); }
    function finance(){ return role('finance'); }
    function manager(){ return role('project_manager') || role('lead_designer'); }
    function internal(){ return ownerAdmin() || finance() || manager() || role('worker') || role('designer'); }
    function client(){ return role('client'); }
    function projectPath(id){ return /databases/$(database)/documents/projects/$(id); }
    function projectExists(id){ return exists(projectPath(id)); }
    function project(id){ return get(projectPath(id)).data; }
    function projectAccess(id){ return active() && projectExists(id) && (ownerAdmin() || request.auth.uid in project(id).accessUserIds); }
    function projectManage(id){ return active() && projectExists(id) && (ownerAdmin() || (manager() && request.auth.uid in project(id).managementUserIds)); }
    function anonymous(){ return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }

    match /users/{uid} {
      allow read: if signedIn() && (ownerAdmin() || request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'displayName','email','phone','company','role','requestedRole','status','profilePhotoUrl','title',
          'onboardingComplete','createdAt','updatedAt'
        ]);
      allow update: if ownerAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName','phone','company','profilePhotoUrl','title','onboardingComplete','updatedAt'
          ]));
      allow delete: if owner();
    }

    match /clients/{clientId} {
      allow read: if ownerAdmin() || finance() || manager()
        || (active() && request.auth.uid in resource.data.userIds);
      allow create, update: if ownerAdmin() || manager();
      allow delete: if owner();
    }

    match /projects/{projectId} {
      allow read: if active() && (ownerAdmin() || request.auth.uid in resource.data.accessUserIds);
      allow create: if ownerAdmin() || manager();
      allow update: if projectManage(projectId);
      allow delete: if owner();
    }

    match /tasks/{taskId} {
      allow read: if projectAccess(resource.data.projectId)
        || (active() && request.auth.uid in resource.data.assigneeIds);
      allow create: if projectManage(request.resource.data.projectId);
      allow update: if projectManage(resource.data.projectId)
        || (active() && request.auth.uid in resource.data.assigneeIds
          && request.resource.data.projectId == resource.data.projectId
          && request.resource.data.assigneeIds == resource.data.assigneeIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','progressNote','blockedReason','submittedAt','updatedAt'
          ]));
      allow delete: if projectManage(resource.data.projectId);
    }

    match /serviceCategories/{id} {
      allow read: if true;
      allow write: if ownerAdmin();
    }

    match /catalogAssets/{id} {
      allow read: if resource.data.published == true || internal();
      allow write: if ownerAdmin();
    }

    match /standards/{id} {
      allow read: if internal();
      allow write: if ownerAdmin();
    }

    match /packageTemplates/{id} {
      allow read: if resource.data.published == true || internal();
      allow write: if ownerAdmin();
    }

    match /contracts/{id} {
      allow read: if finance() || projectAccess(resource.data.projectId);
      allow create, update: if ownerAdmin() || finance() || manager();
      allow delete: if owner();
    }

    match /invoices/{id} {
      allow read: if finance() || projectAccess(resource.data.projectId);
      allow create, update: if ownerAdmin() || finance();
      allow delete: if owner();
    }

    match /payments/{id} {
      allow read: if finance() || projectAccess(resource.data.projectId);
      allow create: if active() && projectAccess(request.resource.data.projectId)
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.submittedBy == request.auth.uid;
      allow update: if ownerAdmin() || finance();
      allow delete: if owner();
    }

    match /expenses/{id} {
      allow read, create, update: if ownerAdmin() || finance();
      allow delete: if owner();
    }

    match /moodboards/{id} {
      allow read: if projectAccess(resource.data.projectId)
        && (internal() || resource.data.clientVisible == true);
      allow create: if projectAccess(request.resource.data.projectId) && internal();
      allow update, delete: if projectManage(resource.data.projectId)
        || (internal() && projectAccess(resource.data.projectId));
    }

    match /moodboardItems/{id} {
      allow read: if projectAccess(resource.data.projectId);
      allow create: if projectAccess(request.resource.data.projectId) && internal();
      allow update, delete: if projectManage(resource.data.projectId)
        || (internal() && projectAccess(resource.data.projectId));
    }

    match /previews/{id} {
      allow read: if projectAccess(resource.data.projectId)
        && (internal() || resource.data.clientVisible == true);
      allow create, update: if internal() && projectAccess(request.resource.data.projectId);
      allow delete: if ownerAdmin();
    }

    match /reviews/{id} {
      allow read: if projectAccess(resource.data.projectId);
      allow create: if active() && projectAccess(request.resource.data.projectId)
        && request.resource.data.actorId == request.auth.uid;
      allow update: if projectManage(resource.data.projectId);
      allow delete: if ownerAdmin();
    }

    match /portfolio/{id} {
      allow read: if ownerAdmin() || (active() && request.auth.uid in resource.data.authorizedUserIds);
      allow create, update: if ownerAdmin() || manager();
      allow delete: if owner();
    }

    match /activity/{id} {
      allow read: if projectAccess(resource.data.projectId);
      allow create: if projectAccess(request.resource.data.projectId)
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /notifications/{id} {
      allow read: if active() && request.auth.uid == resource.data.userId;
      allow create: if ownerAdmin() || manager();
      allow update: if active() && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt','seen','updatedAt']);
      allow delete: if active() && request.auth.uid == resource.data.userId;
    }

    match /workerInvites/{id} {
      allow read, write: if ownerAdmin();
    }

    match /settings/{id} {
      allow read: if internal();
      allow write: if ownerAdmin();
    }

    match /termsVersions/{id} {
      allow read: if resource.data.published == true || ownerAdmin();
      allow write: if ownerAdmin();
    }

    match /legalAcceptances/{id} {
      allow read: if ownerAdmin() || (signedIn() && request.auth.uid == resource.data.userId);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /packageRequests/{id} {
      allow create: if anonymous()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'new';
      allow read, update: if ownerAdmin() || manager();
      allow delete: if ownerAdmin();
    }

    match /messages/{id} {
      allow read: if projectAccess(resource.data.projectId);
      allow create: if active() && projectAccess(request.resource.data.projectId)
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if ownerAdmin();
    }
  }
}
